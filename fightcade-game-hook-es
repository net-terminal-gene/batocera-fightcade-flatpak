#!/usr/bin/env python3
# Installed as /userdata/system/scripts/fightcade-game-hook (see install.sh).
#
# Batocera v44 batocera-launch waits on gameStart subprocess stdio pipes and can
# stall for minutes. Bash background jobs can keep those pipes open. This wrapper
# returns immediately on gameStart after spawning the real hook in a new session.

from __future__ import annotations

import os
import subprocess
import sys

REAL = "/userdata/system/fightcade-flatpak/fightcade-game-hook"
APP_ID = "com.fightcade.Fightcade"
ASYNC_LOG = "/userdata/system/logs/fightcade-hook-async.log"


def _rom_id(path: str) -> str | None:
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return None


def _is_fightcade_flatpak(argv: list[str]) -> bool:
    if len(argv) < 6:
        return False
    event = argv[1]
    system = argv[2]
    rom = argv[5]
    if event not in ("gameStart", "gameStop"):
        return False
    if system != "flatpak":
        return False
    if not os.path.isfile(rom):
        return False
    return _rom_id(rom) == APP_ID


def main() -> int:
    argv = sys.argv
    if len(argv) < 2:
        return 0

    event = argv[1]
    if event in ("start", "boot"):
        os.execv(REAL, [REAL, *argv[1:]])

    if not _is_fightcade_flatpak(argv):
        return 0

    if event == "gameStart":
        log = open(ASYNC_LOG, "ab", buffering=0)  # noqa: SIM115
        subprocess.Popen(  # noqa: S603
            [REAL, *argv[1:]],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
            close_fds=True,
        )
        return 0

    os.execv(REAL, [REAL, *argv[1:]])


if __name__ == "__main__":
    raise SystemExit(main())
