#!/bin/bash
# Diagnostic report for the Fightcade Flatpak ROMs installer.
# Prints install state, symlink health, and Flatpak override contents.
# Read-only: nothing is modified.

set -eu

APP_ID="com.fightcade.Fightcade"
PROJECT_DIR="/userdata/system/fightcade-flatpak"
CRT_DIR="${PROJECT_DIR}/crt"
HD_DIR="${PROJECT_DIR}/hd"
INPUT_DIR="${PROJECT_DIR}/input"
SCRIPTS_DIR="/userdata/system/scripts"
FLATPAK_DATA="/userdata/saves/flatpak/data/.var/app/${APP_ID}/data"
ROMS_ROOT="${FLATPAK_DATA}/ROMs"
HOST_ROMS="/userdata/roms"

pass()  { printf '[PASS] %s\n' "$*"; }
fail()  { printf '[FAIL] %s\n' "$*"; }
info()  { printf '       %s\n' "$*"; }
head_section() { printf '\n--- %s ---\n' "$*"; }

any_fail=0

check() {
    local label="$1"
    local result="$2"
    if [ "$result" = "ok" ]; then
        pass "$label"
    else
        fail "$label — $result"
        any_fail=1
    fi
}

printf '%s\n' '============================================================'
printf '%s\n' ' Fightcade Flatpak ROMs — Diagnostic Report'
printf '%s\n' '============================================================'

# ---------------------------------------------------------------------------
head_section "Flatpak"
# ---------------------------------------------------------------------------

if flatpak info --system "${APP_ID}" >/dev/null 2>&1; then
    ver=$(flatpak info --system "${APP_ID}" 2>/dev/null | awk '/Version/{print $2}')
    pass "Fightcade Flatpak installed system-wide (${ver:-unknown version})"
else
    fail "Fightcade Flatpak NOT installed system-wide"
    any_fail=1
fi

# ---------------------------------------------------------------------------
head_section "Installed scripts"
# ---------------------------------------------------------------------------

branch_file="${PROJECT_DIR}/.install-branch"
if [ -f "${branch_file}" ]; then
    installed_branch=$(tr -d '[:space:]' < "${branch_file}")
    if [ -n "${installed_branch}" ]; then
        pass "Installer source branch: ${installed_branch}"
    else
        info "Installer source branch: unknown (empty ${branch_file})"
    fi
else
    info "Installer source branch: unknown (re-run install.sh to record)"
fi

for f in fightcade-roms-sync fightcade-game-hook fightcade-diagnose uninstall.sh install.sh; do
    path="${PROJECT_DIR}/${f}"
    if [ -x "$path" ]; then
        pass "${path}"
    elif [ -f "$path" ]; then
        fail "${path} (not executable)"
        any_fail=1
    else
        fail "${path} (missing)"
        any_fail=1
    fi
done

for f in fightcade-pad-mouse fightcade-cursor; do
    path="${INPUT_DIR}/${f}"
    if [ -x "$path" ]; then
        pass "${path}"
    elif [ -f "$path" ]; then
        fail "${path} (not executable)"
        any_fail=1
    else
        fail "${path} (missing)"
        any_fail=1
    fi
done

for f in fightcade-crt-switchres fightcade-crt-hostd fightcade-crt-recover fightcade-crt-block-pad-kbd; do
    path="${CRT_DIR}/${f}"
    if [ -x "$path" ]; then
        pass "${path}"
    elif [ -f "$path" ]; then
        fail "${path} (not executable)"
        any_fail=1
    else
        fail "${path} (missing)"
        any_fail=1
    fi
done

hd_patch="${HD_DIR}/patch-hd-video.sh"
if [ -x "$hd_patch" ]; then
    pass "${hd_patch}"
elif [ -f "$hd_patch" ]; then
    fail "${hd_patch} (not executable)"
    any_fail=1
else
    fail "${hd_patch} (missing)"
    any_fail=1
fi

hook="${SCRIPTS_DIR}/fightcade-game-hook"
if [ -x "$hook" ]; then
    pass "game hook: ${hook}"
else
    fail "game hook missing or not executable: ${hook}"
    any_fail=1
fi

# ---------------------------------------------------------------------------
head_section "ROMs scaffold"
# ---------------------------------------------------------------------------

for d in fbneo flycast ggpofba; do
    p="${ROMS_ROOT}/${d}"
    if [ -d "$p" ] && [ ! -L "$p" ]; then
        pass "real dir: ROMs/${d}"
    elif [ -d "$p" ]; then
        info "ROMs/${d} is a symlink (expected real dir)"
        fail "ROMs/${d} should be a real directory"
        any_fail=1
    else
        fail "missing: ROMs/${d}"
        any_fail=1
    fi
done

# ---------------------------------------------------------------------------
head_section "Dir symlinks"
# ---------------------------------------------------------------------------

check_link() {
    local label="$1"
    local link="$2"
    local expected_target="$3"

    if [ -L "$link" ]; then
        actual=$(readlink "$link")
        if [ "$actual" = "$expected_target" ]; then
            if [ -d "$link" ]; then
                pass "$label -> ${expected_target}"
            else
                fail "$label -> ${expected_target} (target missing on host)"
                any_fail=1
            fi
        else
            fail "$label -> ${actual} (expected ${expected_target})"
            any_fail=1
        fi
    elif [ -d "$link" ]; then
        info "$label: real dir exists (host path absent or not yet linked)"
    else
        fail "$label: missing"
        any_fail=1
    fi
}

check_link "snes9x"            "${ROMS_ROOT}/snes9x"              "${HOST_ROMS}/snes"
check_link "fbneo/megadrive"   "${ROMS_ROOT}/fbneo/megadrive"     "${HOST_ROMS}/megadrive"
check_link "fbneo/nes"         "${ROMS_ROOT}/fbneo/nes"           "${HOST_ROMS}/nes"
check_link "fbneo/gamegear"    "${ROMS_ROOT}/fbneo/gamegear"      "${HOST_ROMS}/gamegear"
check_link "fbneo/coleco"      "${ROMS_ROOT}/fbneo/coleco"        "${HOST_ROMS}/colecovision"
check_link "fbneo/pce"         "${ROMS_ROOT}/fbneo/pce"           "${HOST_ROMS}/pcengine"
check_link "fbneo/sg1000"      "${ROMS_ROOT}/fbneo/sg1000"        "${HOST_ROMS}/sg1000"
check_link "fbneo/msx"         "${ROMS_ROOT}/fbneo/msx"           "${HOST_ROMS}/msx1"
check_link "flycast/atomiswave" "${ROMS_ROOT}/flycast/atomiswave" "${HOST_ROMS}/atomiswave"
check_link "flycast/naomi"     "${ROMS_ROOT}/flycast/naomi"       "${HOST_ROMS}/naomi"
check_link "flycast/naomi2"    "${ROMS_ROOT}/flycast/naomi2"      "${HOST_ROMS}/naomi2"

if [ -L "${ROMS_ROOT}/flycast/dreamcast" ]; then
    fail "legacy flycast/dreamcast dir link still present (run fightcade-roms-sync)"
    any_fail=1
elif [ -e "${ROMS_ROOT}/flycast/dreamcast" ]; then
    info "flycast/dreamcast path exists but is not the old managed dir link"
fi

# ---------------------------------------------------------------------------
head_section "fbneo arcade per-zip links"
# ---------------------------------------------------------------------------

if [ -d "${HOST_ROMS}/fbneo" ]; then
    src_count=$(find "${HOST_ROMS}/fbneo" -maxdepth 1 -name '*.zip' 2>/dev/null | wc -l | tr -d ' ')
    dst_count=$(find "${ROMS_ROOT}/fbneo" -maxdepth 1 -name '*.zip' -type l 2>/dev/null | wc -l | tr -d ' ')
    dangling=$(find "${ROMS_ROOT}/fbneo" -maxdepth 1 -name '*.zip' -type l 2>/dev/null \
        | while read -r l; do [ -e "$l" ] || printf '%s\n' "$l"; done | wc -l | tr -d ' ')

    pass "source zips in ${HOST_ROMS}/fbneo: ${src_count}"
    pass "managed arcade links in ROMs/fbneo: ${dst_count}"
    if [ "$dangling" -gt 0 ]; then
        fail "dangling arcade links: ${dangling} (run fightcade-roms-sync to prune)"
        any_fail=1
    else
        pass "no dangling arcade links"
    fi
else
    info "${HOST_ROMS}/fbneo does not exist; arcade links not applicable"
fi

# ---------------------------------------------------------------------------
head_section "flycast Dreamcast per-file links"
# ---------------------------------------------------------------------------

if [ -d "${HOST_ROMS}/dreamcast" ]; then
    dc_src=$(find "${HOST_ROMS}/dreamcast" -maxdepth 1 \( -name '*.chd' -o -name '*.cdi' \) 2>/dev/null | wc -l | tr -d ' ')
    dc_dst=0
    dc_dangling=0
    for l in "${ROMS_ROOT}/flycast"/*.{chd,cdi}; do
        [ -L "$l" ] || continue
        target=$(readlink "$l")
        case "$target" in
            "${HOST_ROMS}/dreamcast/"*)
                dc_dst=$((dc_dst + 1))
                [ -e "$l" ] || dc_dangling=$((dc_dangling + 1))
                ;;
        esac
    done

    pass "source roms in ${HOST_ROMS}/dreamcast: ${dc_src}"
    pass "managed dreamcast links in ROMs/flycast: ${dc_dst}"
    if [ "$dc_dangling" -gt 0 ]; then
        fail "dangling dreamcast links: ${dc_dangling} (run fightcade-roms-sync to prune)"
        any_fail=1
    else
        pass "no dangling dreamcast links"
    fi
    if [ "$dc_src" -gt 0 ] && [ "$dc_dst" -lt "$dc_src" ]; then
        fail "dreamcast link count below source count (run fightcade-roms-sync)"
        any_fail=1
    fi
else
    info "${HOST_ROMS}/dreamcast does not exist; dreamcast links not applicable"
fi

# ---------------------------------------------------------------------------
head_section "Flatpak overrides"
# ---------------------------------------------------------------------------

if flatpak override --system --show "${APP_ID}" >/dev/null 2>&1; then
    overrides=$(flatpak override --system --show "${APP_ID}" 2>/dev/null | grep -i filesystem || true)
    if [ -n "$overrides" ]; then
        pass "Filesystem overrides:"
        printf '%s\n' "$overrides" | while IFS= read -r line; do
            info "$line"
        done
    else
        fail "No filesystem overrides found for ${APP_ID}"
        any_fail=1
    fi

    if flatpak override --system --show "${APP_ID}" 2>/dev/null | grep -q '^vblank_mode=3'; then
        pass "Forced vsync override: vblank_mode=3"
    else
        fail "Missing vblank_mode=3 override (SNES will tear on CRT); re-run install.sh"
        any_fail=1
    fi
else
    fail "Could not read overrides for ${APP_ID}"
    any_fail=1
fi

# ---------------------------------------------------------------------------
head_section "Artwork / gamelist"
# ---------------------------------------------------------------------------

FLATPAK_ROMS_DIR="/userdata/roms/flatpak"

for art in Fightcade.png Fightcade-logo.png Fightcade-thumb.png; do
    if [ -f "${FLATPAK_ROMS_DIR}/images/${art}" ]; then
        pass "artwork: images/${art}"
    else
        fail "artwork missing: ${FLATPAK_ROMS_DIR}/images/${art}"
        any_fail=1
    fi
done

legacy_art="${FLATPAK_ROMS_DIR}/images/Fightcade-image.png"
if [ -f "$legacy_art" ]; then
    info "legacy artwork present: images/Fightcade-image.png (re-run install.sh to replace with Fightcade-thumb.png)"
fi

if [ -f "${FLATPAK_ROMS_DIR}/gamelist.xml" ]; then
    if grep -q '<path>\./Fightcade\.flatpak</path>' "${FLATPAK_ROMS_DIR}/gamelist.xml"; then
        pass "gamelist.xml has Fightcade entry"
        if grep -q '<image>\./images/Fightcade\.png</image>' "${FLATPAK_ROMS_DIR}/gamelist.xml" \
            && grep -q '<marquee>\./images/Fightcade-logo\.png</marquee>' "${FLATPAK_ROMS_DIR}/gamelist.xml" \
            && grep -q '<thumbnail>\./images/Fightcade-thumb\.png</thumbnail>' "${FLATPAK_ROMS_DIR}/gamelist.xml"; then
            pass "gamelist.xml Fightcade artwork paths (logo / marquee / thumbnail)"
        else
            fail "gamelist.xml Fightcade entry has outdated artwork paths (re-run install.sh)"
            any_fail=1
        fi
    else
        fail "gamelist.xml exists but has no Fightcade entry"
        any_fail=1
    fi
else
    fail "gamelist.xml missing: ${FLATPAK_ROMS_DIR}/gamelist.xml"
    any_fail=1
fi

if pgrep -f 'fightcade-pad-mouse' >/dev/null 2>&1 || [ -f /tmp/fightcade-pad-mouse.pid ]; then
    pass "pad-mouse daemon running"
else
    info "pad-mouse not running (starts on Fightcade gameStart)"
fi

if [ -f /userdata/system/configs/fightcade-pad-mouse.disable ]; then
    info "pad-mouse disabled via fightcade-pad-mouse.disable"
fi

# ---------------------------------------------------------------------------
head_section "CRT / Switchres (xdg-open model)"
# ---------------------------------------------------------------------------

if command -v wmctrl >/dev/null 2>&1; then
    pass "wmctrl present (window-exit detection enabled)"
elif command -v xdotool >/dev/null 2>&1; then
    pass "xdotool present (window-exit detection enabled)"
else
    info "wmctrl/xdotool not installed; wrapper relies on process detection only"
fi

if [ -x /usr/bin/switchres ]; then
    pass "switchres binary present"
else
    info "switchres not present; CRT switching not available on this build"
fi

wrap="${CRT_DIR}/fightcade-crt-switchres"
if [ -x "$wrap" ]; then
    pass "Switchres wrapper installed: ${wrap}"
else
    fail "Switchres wrapper missing: ${wrap}"
    any_fail=1
fi

deploy=$(flatpak info --system --show-location "${APP_ID}" 2>/dev/null || true)
if [ -n "$deploy" ]; then
    xdg_open="${deploy}/files/bin/xdg-open"
    backup="${xdg_open}.fc-original"
    if [ -f "$backup" ] && grep -q 'play.pending' "$xdg_open" 2>/dev/null \
        && grep -q 'fcade-quark' "$xdg_open" 2>/dev/null \
        && grep -q 'served|training|stream' "$xdg_open" 2>/dev/null; then
        pass "Flatpak xdg-open patched (play/served/training/stream → play.pending)"
    elif [ -f "$backup" ] && grep -q 'play.pending' "$xdg_open" 2>/dev/null \
        && grep -q 'fcade-quark' "$xdg_open" 2>/dev/null; then
        info "Flatpak xdg-open patched for play only (re-run install.sh for full game-mode CRT)"
    elif [ -f "$backup" ]; then
        fail "Flatpak xdg-open backup exists but xdg-open is not patched (re-run install.sh)"
        any_fail=1
    else
        fail "Flatpak xdg-open not patched (re-run install.sh)"
        any_fail=1
    fi

hostd="${CRT_DIR}/fightcade-crt-hostd"
if [ -x "$hostd" ]; then
    pass "CRT host watcher installed: ${hostd}"
else
    fail "CRT host watcher missing: ${hostd}"
    any_fail=1
fi

if pgrep -f 'fightcade-crt-hostd daemon' >/dev/null 2>&1; then
    pass "CRT host watcher is running"
elif flatpak ps 2>/dev/null | grep -q com.fightcade.Fightcade; then
    info "Fightcade is open but CRT host watcher is not running (relaunch Fightcade from ES)"
fi
else
    fail "Could not read Flatpak deploy path for xdg-open check"
    any_fail=1
fi

if pgrep -f 'fightcade-crt-watch' >/dev/null 2>&1; then
    fail "legacy fightcade-crt-watch daemon still running (re-run install.sh)"
    any_fail=1
fi

if pgrep -f 'fightcade-crt-switchres' >/dev/null 2>&1; then
    info "Switchres wrapper active (game session in progress)"
fi

dm=$(batocera-resolution getDisplayMode 2>/dev/null || echo "unknown")
res=$(batocera-resolution currentResolution 2>/dev/null || echo "unknown")
info "display mode: ${dm}  current resolution: ${res}"

if [ -f /userdata/system/configs/fightcade-switchres.disable ]; then
    info "kill switch present: Switchres DISABLED for Fightcade"
elif [ -f /userdata/system/configs/fightcade-switchres.force ]; then
    info "force file present: Switchres FORCED on for Fightcade"
else
    w="${res%%x*}"
    case "$w" in
        *[!0-9]*|'') info "cannot determine width; wrapper will decide at launch" ;;
        *)
            if [ "$dm" = "xorg" ] && [ "$w" -lt 1024 ]; then
                info "Switchres will engage on game launch (xorg, width < 1024)"
            else
                info "Switchres will NOT engage (needs xorg display mode and width < 1024)"
            fi
            ;;
    esac
fi

if [ -f /tmp/fightcade-crt-watch.pid ]; then
    info "stale legacy pid file present (safe to remove after install.sh)"
fi

for cfg in "${FLATPAK_DATA}/config/fcadefbneo/fcadefbneo.ini" \
           "${FLATPAK_DATA}/config/snes9x/fcadesnes9x.conf" \
           "${FLATPAK_DATA}/config/flycast/emu.cfg"; do
    if [ -f "${cfg}.bak.switchres" ]; then
        fail "leftover Switchres backup: ${cfg}.bak.switchres (run crt/fightcade-crt-recover)"
        any_fail=1
    fi
done

# ---------------------------------------------------------------------------
head_section "HD video defaults"
# ---------------------------------------------------------------------------

hd_w=1920
hd_h=1080
hd_raw=""

if command -v batocera-resolution >/dev/null 2>&1; then
    hd_raw=$(DISPLAY=:0 batocera-resolution currentResolution 2>/dev/null | head -n1 | tr -d '[:space:]')
fi
if [ -z "$hd_raw" ] && command -v xrandr >/dev/null 2>&1; then
    hd_raw=$(DISPLAY=:0 xrandr --currentResolution 2>/dev/null | tail -n1 | awk '{print $1}')
fi
if [[ "$hd_raw" =~ ^([0-9]+)x([0-9]+) ]]; then
    hd_w="${BASH_REMATCH[1]}"
    hd_h="${BASH_REMATCH[2]}"
fi
info "detected display resolution for HD checks: ${hd_w}x${hd_h}"

for preset in fcadefbneo.ini fcadesnes9x.conf flycast/emu.cfg; do
    p="${HD_DIR}/presets/${preset}"
    if [ -f "$p" ]; then
        pass "HD preset bundled: hd/presets/${preset}"
    else
        fail "HD preset missing: hd/presets/${preset}"
        any_fail=1
    fi
done

check_hd_ini_key() {
    local label="$1" file="$2" pattern="$3"
    if [ ! -f "$file" ]; then
        info "${label}: config not present yet"
        return 0
    fi
    if grep -qE "$pattern" "$file"; then
        pass "${label}"
    else
        fail "${label} (run hd/patch-hd-video.sh)"
        any_fail=1
    fi
}

check_hd_ini_key "FBNeo correct aspect" \
    "${FLATPAK_DATA}/config/fcadefbneo/fcadefbneo.ini" '^bVidCorrectAspect 1'
check_hd_ini_key "FBNeo no full stretch" \
    "${FLATPAK_DATA}/config/fcadefbneo/fcadefbneo.ini" '^bVidFullStretch 0'
check_hd_ini_key "FBNeo vsync" \
    "${FLATPAK_DATA}/config/fcadefbneo/fcadefbneo.ini" '^bVidVSync 1'
check_hd_ini_key "FBNeo hor width" \
    "${FLATPAK_DATA}/config/fcadefbneo/fcadefbneo.ini" "^nVidHorWidth ${hd_w}"
check_hd_ini_key "SNES9x fullscreen width" \
    "${FLATPAK_DATA}/config/snes9x/fcadesnes9x.conf" "Fullscreen:Width[[:space:]]*=[[:space:]]*${hd_w}"
check_hd_ini_key "SNES9x fullscreen height" \
    "${FLATPAK_DATA}/config/snes9x/fcadesnes9x.conf" "Fullscreen:Height[[:space:]]*=[[:space:]]*${hd_h}"
check_hd_ini_key "SNES9x vsync" \
    "${FLATPAK_DATA}/config/snes9x/fcadesnes9x.conf" 'Vsync[[:space:]]*=[[:space:]]*TRUE'
check_hd_ini_key "Flycast fullscreen" \
    "${FLATPAK_DATA}/config/flycast/emu.cfg" '^fullscreen = yes'
check_hd_ini_key "Flycast window width" \
    "${FLATPAK_DATA}/config/flycast/emu.cfg" "^width = ${hd_w}"
check_hd_ini_key "Flycast vsync" \
    "${FLATPAK_DATA}/config/flycast/emu.cfg" '^rend\.vsync = yes'

# ---------------------------------------------------------------------------
head_section "Lobby zoom (HD vs CRT)"
# ---------------------------------------------------------------------------

ZOOM_TOOL="${PROJECT_DIR}/fightcade-lobby-zoom"
ZOOM_CONF="/userdata/system/configs/fightcade-lobby-zoom.conf"

if [ -x "$ZOOM_TOOL" ]; then
    pass "lobby-zoom tool installed: fightcade-lobby-zoom"
    if [ -f "$ZOOM_CONF" ]; then
        info "saved zoom levels (${ZOOM_CONF}):"
        info "  HD  = $(sed -n 's/^zoom_hd=//p' "$ZOOM_CONF" | tail -1)"
        info "  CRT = $(sed -n 's/^zoom_crt=//p' "$ZOOM_CONF" | tail -1)"
    else
        info "no saved zoom yet (captured when you exit Fightcade in each mode)"
    fi
else
    info "lobby-zoom tool not installed (re-run installer to add per-mode zoom)"
fi

# ---------------------------------------------------------------------------
head_section "Dreamcast BIOS"
# ---------------------------------------------------------------------------

BIOS_DIR="${FLATPAK_DATA%/data}/config/flycast/data"
for bios in dc_boot.bin dc_flash.bin; do
    if [ -f "${BIOS_DIR}/${bios}" ]; then
        pass "${bios} present in ${BIOS_DIR}"
    else
        info "${bios} not found at ${BIOS_DIR}/${bios}"
        info "(Dreamcast requires BIOS here; Naomi/Atomiswave do not)"
    fi
done

# ---------------------------------------------------------------------------
printf '\n'
printf '%s\n' '============================================================'
if [ "$any_fail" -eq 0 ]; then
    printf '%s\n' ' All checks passed.'
else
    printf '%s\n' ' One or more checks failed. Review [FAIL] lines above.'
fi
printf '%s\n' '============================================================'
printf '\n'

exit "$any_fail"
