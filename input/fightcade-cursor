#!/bin/bash
# Show or hide the mouse cursor during Fightcade lobby vs in-game sessions.
# X11 (CRT / HDMI PCs): dedicated unclutter instance (pidfile), never ES unclutter.
# Wayland (Steam Deck / labwc): stock ShowCursor / HideCursor keybinds (A-W-s / A-W-h).
# Never edits labwc rc.xml (Batocera display rotation must not be touched).
#
# Usage: fightcade-cursor show|hide

PIDFILE="/tmp/fightcade-cursor-unclutter.pid"
WL_STATE="/tmp/fightcade-cursor-wayland.state"

pick_display() {
    [ -S /tmp/.X11-unix/X0 ] && { echo ":0.0"; return; }
    [ -S /tmp/.X11-unix/X1 ] && { echo ":1.0"; return; }
    echo "${DISPLAY:-:0.0}"
}

wayland_session() {
    [ -n "${WAYLAND_DISPLAY:-}" ] && return 0
    local base name
    for base in "${XDG_RUNTIME_DIR:-}" /run /var/run; do
        [ -n "$base" ] && [ -d "$base" ] || continue
        for name in "$base"/wayland-*; do
            [ -e "$name" ] || continue
            case "$name" in *.lock) continue ;; esac
            return 0
        done
    done
    return 1
}

wayland_ensure_env() {
    [ -n "${WAYLAND_DISPLAY:-}" ] || export WAYLAND_DISPLAY=wayland-0
    [ -n "${XDG_RUNTIME_DIR:-}" ] || export XDG_RUNTIME_DIR=/var/run
}

# Batocera labwc rc.xml: A-W-s = ShowCursor; A-W-h = HideCursor (+ WarpCursor).
cursor_labwc_hide() {
    command -v wtype >/dev/null 2>&1 || return 0
    [ -f "$WL_STATE" ] && [ "$(cat "$WL_STATE" 2>/dev/null)" = hidden ] && return 0
    wayland_ensure_env
    wtype -M alt -M logo -P h -p h 2>/dev/null || true
    printf 'hidden\n' > "$WL_STATE"
}

cursor_labwc_show() {
    command -v wtype >/dev/null 2>&1 || return 0
    [ -f "$WL_STATE" ] && [ "$(cat "$WL_STATE" 2>/dev/null)" = visible ] && return 0
    wayland_ensure_env
    wtype -M alt -M logo -P s -p s 2>/dev/null || true
    printf 'visible\n' > "$WL_STATE"
}

cursor_show() {
    if wayland_session; then
        cursor_labwc_show
        return 0
    fi
    if [ ! -f "$PIDFILE" ]; then
        return 0
    fi
    local pid
    pid=$(cat "$PIDFILE" 2>/dev/null)
    rm -f "$PIDFILE"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    for _ in 1 2 3 4 5; do
        [ -z "$pid" ] && break
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.05
    done
    [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null
}

cursor_hide() {
    if wayland_session; then
        cursor_labwc_hide
        return 0
    fi
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE" 2>/dev/null)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
        rm -f "$PIDFILE"
    fi
    command -v unclutter >/dev/null 2>&1 || return 0
    export DISPLAY
    DISPLAY=$(pick_display)
    unclutter -timeout 0 >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
}

case "${1:-}" in
    show) cursor_show ;;
    hide) cursor_hide ;;
    *)
        echo "Usage: ${0##*/} show|hide" >&2
        exit 1
        ;;
esac
