def send_lobby_chat_message(display: str, message: str) -> None:
    """Type message and newline (Electron chat accepts typed \\n, not key Return)."""
    if not message:
        return
    env = os.environ.copy()
    env["DISPLAY"] = display
    wid = _fightcade_window_id(display)
    try:
        type_base = ["xdotool", "type", "--clearmodifiers", "--delay", "12"]
        if wid:
            type_base.extend(["--window", wid])
        subprocess.run(
            type_base + [message],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=5,
            check=False,
        )
        time.sleep(0.08)
        subprocess.run(
            type_base + ["\n"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=3,
            check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log(f"lobby chat failed: {exc}")


