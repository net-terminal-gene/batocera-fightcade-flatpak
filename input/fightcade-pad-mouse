def log(msg: str) -> None:
    if os.environ.get("FIGHTCADE_PAD_MOUSE_QUIET"):
        return
    sys.stderr.write(f"fightcade-pad-mouse: {msg}\n")


def load_conf() -> dict:
    cfg = dict(DEFAULTS)
    if not os.path.isfile(CONF):
        return cfg
    try:
        with open(CONF, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, val = line.split("=", 1)
                key = key.strip().lower()
                val = val.strip()
                if key in cfg:
                    if isinstance(cfg[key], bool):
                        cfg[key] = val.lower() in ("1", "true", "yes", "on")
                    elif isinstance(cfg[key], int):
                        cfg[key] = int(val)
                    elif isinstance(cfg[key], float):
                        cfg[key] = float(val)
                    else:
                        cfg[key] = val
    except (OSError, ValueError) as exc:
        log(f"config parse warning: {exc}")
    return cfg


def _strip_chat_value(val: str) -> str:
    val = val.strip()
    if len(val) >= 2 and val[0] == val[-1] and val[0] in "\"'":
        return val[1:-1]
    return val


def _parse_chat_conf(path: str) -> dict[str, str]:
    macros: dict[str, str] = {}
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, val = line.split("=", 1)
                key = key.strip().lower()
                if key in CHAT_SLOTS:
                    macros[key] = _strip_chat_value(val)
    except OSError as exc:
        log(f"chat config parse warning {path}: {exc}")
    return macros


def resolve_chat_conf_path() -> str:
    for path in (CHAT_CONF, CHAT_CONF_LEGACY, CHAT_CONF_SHIPPED):
        if os.path.isfile(path):
            return path
    return CHAT_CONF


def load_chat_macros() -> dict[str, str]:
    """Lobby chat lines for R1+slot. Empty value in config disables a slot."""
    macros = dict(DEFAULT_CHAT_MACROS)
    path = resolve_chat_conf_path()
    if os.path.isfile(path):
        macros.update(_parse_chat_conf(path))
    return {slot: macros[slot] for slot in CHAT_SLOTS if macros.get(slot)}


def pick_display() -> str:
    if os.path.exists("/tmp/.X11-unix/X0"):
        return ":0.0"
    if os.path.exists("/tmp/.X11-unix/X1"):
        return ":1.0"
    return os.environ.get("DISPLAY", ":0.0")


def pgrep_running(pattern: str) -> bool:
    try:
        out = subprocess.run(
            ["pgrep", "-f", pattern],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        return out.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def scan_fightcade_processes() -> dict[str, bool]:
    """One pgrep for all Fightcade-related processes (avoids 4x subprocess in lobby)."""
    found = {
        "fc": False,
        "fbneo": False,
        "snes9x": False,
        "flycast": False,
    }
    try:
        out = subprocess.run(
            [
                "pgrep",
                "-af",
                "fc2-electron|fcadefbneo|fcadesnes9x|flycast\\.elf",
            ],
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if out.returncode != 0:
            return found
        for line in out.stdout.splitlines():
            if "fc2-electron" in line:
                found["fc"] = True
            if "fcadefbneo" in line:
                found["fbneo"] = True
            if "fcadesnes9x" in line:
                found["snes9x"] = True
            if "flycast.elf" in line:
                found["flycast"] = True
    except (OSError, subprocess.SubprocessError):
        pass
    return found


def fightcade_running() -> bool:
    return pgrep_running("fc2-electron")


def fightcade_fbneo_running() -> bool:
    return pgrep_running(FBNEO_PGREP_RE)


def fightcade_snes9x_running() -> bool:
    return pgrep_running(SNES9X_PGREP_RE)


def fightcade_wine_menu_emu_running() -> bool:
    return fightcade_fbneo_running() or fightcade_snes9x_running()


def fightcade_fbneo_active() -> bool:
    if not fightcade_wine_menu_emu_running():
        if os.path.isfile(FBNEO_FLAG):
            try:
                os.remove(FBNEO_FLAG)
            except OSError:
                pass
        return False
    return os.path.isfile(FBNEO_FLAG)


def wine_menu_emu_in_focus(focus_name: str) -> str | None:
    focus = focus_name.lower()
    if fightcade_fbneo_running() and "fbneo" in focus:
        return "fbneo"
    if fightcade_snes9x_running() and "snes9x" in focus:
        return "snes9x"
    return None


def read_focused_window_name(display: str) -> str:
    try:
        out = subprocess.run(
            ["xdotool", "getwindowfocus", "getwindowname"],
            env={**os.environ, "DISPLAY": display},
            capture_output=True,
            text=True,
            timeout=1,
            check=False,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return ""


def fightcade_flycast_running() -> bool:
    return pgrep_running(FLYCAST_PGREP_RE)


def flycast_window_has_game(display: str) -> bool:
    if not fightcade_flycast_running():
        return False
    env = {**os.environ, "DISPLAY": display}
    try:
        wmctrl = subprocess.run(
            ["wmctrl", "-l"],
            env=env,
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if wmctrl.returncode == 0:
            for line in wmctrl.stdout.splitlines():
                lower = line.lower()
                if "flycast" not in lower:
                    continue
                if "no game loaded" in lower:
                    return False
                return True
            return False

        out = subprocess.run(
            ["xdotool", "search", "--name", "flycast"],
            env=env,
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if out.returncode != 0:
            return False
        for wid in out.stdout.split():
            wid = wid.strip()
            if not wid:
                continue
            title_out = subprocess.run(
                ["xdotool", "getwindowname", wid],
                env=env,
                capture_output=True,
                text=True,
                timeout=2,
                check=False,
            )
            title = title_out.stdout.strip().lower()
            if "no game loaded" in title:
                return False
            return True
    except (OSError, subprocess.SubprocessError):
        return False
    return False


class SessionState:
    """Cached Fightcade session flags; avoids pgrep/xdotool in the 60Hz input loop.

    LOBBY FAST PATH (critical): While Fightcade lobby is open and no emulator is
    running, refresh() must NOT call xdotool getwindowfocus, wmctrl, or
    set_cursor_visible. Those contend with the 60Hz stick→xdotool mouse path and
    make lobby navigation slow/jittery. Full focus polling is only for in-game CRT
    combos (SELECT+X/Y, Flycast cursor). Do not "simplify" by always polling focus.
    """

    def __init__(self, refresh_sec: float = 0.25, lobby_refresh_sec: float = 2.0) -> None:
        self.refresh_sec = refresh_sec
        self.lobby_refresh_sec = lobby_refresh_sec
        self.last_refresh = 0.0
        self.last_lobby_refresh = 0.0
        self.fc_running = False
        self.fbneo_running = False
        self.snes9x_running = False
        self.fbneo_active = False
        self.flycast_game_active = False
        self.crt_paused = False
        self.focus_name = ""
        self.in_lobby = True

    def _apply_process_scan(self, procs: dict[str, bool]) -> None:
        self.fc_running = procs["fc"]
        self.fbneo_running = procs["fbneo"]
        self.snes9x_running = procs["snes9x"]

    def refresh(self, display: str, force: bool = False) -> None:
        now = time.monotonic()
        self.crt_paused = crt_paused()

        if not force and now - self.last_lobby_refresh < self.lobby_refresh_sec:
            if self.in_lobby and not self.crt_paused:
                return

        procs = scan_fightcade_processes()
        self._apply_process_scan(procs)
        need_game_state = (
            self.crt_paused
            or procs["fbneo"]
            or procs["snes9x"]
            or procs["flycast"]
            or os.path.isfile(FLYCAST_GAME_FLAG)
            or os.path.isfile(FBNEO_FLAG)
        )

        if not need_game_state:
            # Lobby only: pgrep at lobby_refresh_sec. No xdotool/wmctrl here.
            self.last_lobby_refresh = now
            self.in_lobby = True
            self.fbneo_active = False
            self.flycast_game_active = False
            self.focus_name = ""
            return

        if not force and now - self.last_refresh < self.refresh_sec:
            return
        self.last_refresh = now
        self.last_lobby_refresh = now
        self.in_lobby = False

        if self.fbneo_running or self.snes9x_running:
            self.fbneo_active = fightcade_fbneo_active()
        else:
            self.fbneo_active = False
        if os.path.isfile(FLYCAST_GAME_FLAG):
            self.flycast_game_active = True
        elif procs["flycast"]:
            self.flycast_game_active = flycast_window_has_game(display)
        else:
            self.flycast_game_active = False
            if os.path.isfile(FLYCAST_GAME_FLAG):
                try:
                    os.remove(FLYCAST_GAME_FLAG)
                except OSError:
                    pass
        self.focus_name = read_focused_window_name(display)

    def lobby_mouse_allowed(self, flycast_menu_cursor: bool) -> bool:
        if self.crt_paused or flycast_menu_cursor:
            return True
        if wine_menu_emu_in_focus(self.focus_name):
            return False
        if self.flycast_game_active and "flycast" in self.focus_name.lower():
            return False
        return True

    def wine_menu_emu_combo_available(self) -> bool:
        return wine_menu_emu_in_focus(self.focus_name) is not None

    def fbneo_combo_available(self) -> bool:
        return self.wine_menu_emu_combo_available()

    def flycast_combo_available(self) -> bool:
        return self.flycast_game_active and "flycast" in self.focus_name.lower()


class XdotoolClient:
    """One long-lived helper; avoids fork/exec on every stick tick."""

    def __init__(self, display: str) -> None:
        self.display = display
        self._proc: subprocess.Popen[bytes] | None = None
        self._start()

    def _start(self) -> None:
        if self._proc is not None and self._proc.poll() is None:
            return
        env = os.environ.copy()
        env["DISPLAY"] = self.display
        self._proc = subprocess.Popen(
            [
                "bash",
                "-c",
                "while read -r cmd a1 a2; do "
                'case "$cmd" in '
                "move) xdotool mousemove_relative -- \"$a1\" \"$a2\" ;; "
                "down) xdotool mousedown \"$a1\" ;; "
                "up) xdotool mouseup \"$a1\" ;; "
                'key) xdotool key --clearmodifiers "$a1" ;; '
                "type) xdotool type --clearmodifiers --delay 12 -- \"$a1\" ;; "
                "esac; done",
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
            bufsize=0,
        )

    def _send(self, line: str) -> None:
        try:
            self._start()
            assert self._proc is not None and self._proc.stdin is not None
            self._proc.stdin.write(f"{line}\n".encode())
            self._proc.stdin.flush()
        except (BrokenPipeError, OSError, AssertionError):
            self._proc = None
            self._start()
            try:
                assert self._proc is not None and self._proc.stdin is not None
                self._proc.stdin.write(f"{line}\n".encode())
                self._proc.stdin.flush()
            except (BrokenPipeError, OSError, AssertionError):
                pass

    def move(self, dx: int, dy: int) -> None:
        if dx == 0 and dy == 0:
            return
        self._send(f"move {dx} {dy}")

    def mouse_button(self, button: int, down: bool) -> None:
        self._send(f"{'down' if down else 'up'} {button}")

    def mouse_down(self) -> None:
        self.mouse_button(1, True)

    def mouse_up(self) -> None:
        self.mouse_button(1, False)

    def key(self, combo: str) -> None:
        self._send(f"key {combo}")

    def type_text(self, text: str) -> None:
        if not text:
            return
        self._send(f"type {text}")

    def close(self) -> None:
        if self._proc is None:
            return
        try:
            if self._proc.stdin:
                self._proc.stdin.close()
        except OSError:
            pass
        try:
            self._proc.terminate()
        except OSError:
            pass
        self._proc = None


def crt_paused() -> bool:
    try:
        with open(CRT_PAUSEFILE, encoding="utf-8") as fh:
            return fh.read().strip() == "1"
    except OSError:
        return False


def clear_crt_pause() -> None:
    try:
        with open(CRT_PAUSEFILE, "w", encoding="utf-8") as fh:
            fh.write("0\n")
    except OSError:
        pass


def list_gamepad_event_nodes(device_match: str) -> list[tuple[str, str]]:
    pads: list[tuple[str, str]] = []
    seen: set[str] = set()

    def add(label: str, event_path: str) -> None:
        if event_path in seen:
            return
        if device_match and device_match.lower() not in label.lower():
            return
        seen.add(event_path)
        pads.append((label, event_path))

    for js_path in sorted(glob.glob("/dev/input/by-id/*-joystick")):
        if js_path.endswith("-event-joystick"):
            continue
        if not os.path.exists(js_path):
            continue
        label = os.path.basename(js_path).removesuffix("-joystick")
        if "Motion" in label:
            continue
        event_path = js_path.replace("-joystick", "-event-joystick")
        if not os.path.exists(event_path):
            continue
        add(label, event_path)

    # Some pads (e.g. Nintendo Switch Pro Controller) only expose *-event-joystick.
    for event_path in sorted(glob.glob("/dev/input/by-id/*-event-joystick")):
        if not os.path.exists(event_path):
            continue
        label = os.path.basename(event_path).removesuffix("-event-joystick")
        if "Motion" in label:
            continue
        add(label, event_path)

    return pads


@dataclass
class PadBindings:
    """Evdev codes resolved from EmulationStation wizard slots (SOUTH/EAST/…)."""

    btn_left: int = BTN_SOUTH
    btn_right: int = BTN_EAST
    btn_combo_west: int = BTN_WEST
    btn_combo_north: int = BTN_NORTH
    btn_select: int = BTN_SELECT
    btn_hotkey: int = -1
    btn_start: int = BTN_START
    btn_r1: int = BTN_TR
    r2_code: int = BTN_TR2
    r2_is_axis: bool = False
    r2_sources: list[tuple[int, bool]] | None = None
    abs_x: int = ABS_X
    abs_y: int = ABS_Y
    abs_hat_x: int = ABS_HAT0X
    abs_hat_y: int = ABS_HAT0Y
    source: str = "unconfigured"
    es_device: str = ""
    es_guid: str = ""

    def select_codes(self) -> tuple[int, ...]:
        codes: list[int] = [self.btn_select]
        if self.btn_hotkey >= 0 and self.btn_hotkey != self.btn_select:
            codes.append(self.btn_hotkey)
        return tuple(codes)

    def _r2_sources_list(self) -> list[tuple[int, bool]]:
        if self.r2_sources:
            return self.r2_sources
        return [(self.r2_code, self.r2_is_axis)]

    @property
    def tracked_abs(self) -> frozenset[int]:
        codes = {self.abs_x, self.abs_y, self.abs_hat_x, self.abs_hat_y}
        for code, is_axis in self._r2_sources_list():
            if is_axis:
                codes.add(code)
        return frozenset(codes)

    def probe_button_names(self) -> dict[int, str]:
        names = {
            self.btn_left: "SOUTH → left click; R1+SOUTH lobby chat",
            self.btn_right: "EAST → right click",
            self.btn_combo_west: "WEST → SELECT+WEST (pause/menu)",
            self.btn_combo_north: "NORTH → SELECT+NORTH (resume)",
            self.btn_r1: "R shoulder → R1+slot lobby chat; SELECT+R1 Alt+Tab",
            self.btn_select: "SELECT",
            self.btn_start: "START → SELECT+Start Alt+F4 (quit emulator)",
        }
        if self.btn_hotkey >= 0 and self.btn_hotkey not in names:
            names[self.btn_hotkey] = "HOTKEY (select chord)"
        for code, is_axis in self._r2_sources_list():
            if is_axis:
                continue
            if code not in names:
                names[code] = "R2 / slow cursor (button)"
        if not self.r2_is_axis and self.r2_code not in names:
            names[self.r2_code] = "R2 / slow cursor (button)"
        return names


def sdl2_joystick_guid(bus: int, vendor: int, product: int, version: int) -> str:
    """Build the same 128-bit GUID string SDL2 / EmulationStation use on Linux."""
    data = bytearray(16)
    struct.pack_into("<H", data, 0, bus & 0xFFFF)
    struct.pack_into("<H", data, 2, 0)
    struct.pack_into("<H", data, 4, vendor & 0xFFFF)
    struct.pack_into("<H", data, 6, 0)
    struct.pack_into("<H", data, 8, product & 0xFFFF)
    struct.pack_into("<H", data, 10, 0)
    struct.pack_into("<H", data, 12, version & 0xFFFF)
    return data.hex()


def evdev_device_guid(event_path: str) -> str:
    if not HAS_EVDEV:
        return ""
    try:
        dev = InputDevice(event_path)
        info = dev.info
        dev.close()
        return sdl2_joystick_guid(info.bustype, info.vendor, info.product, info.version)
    except OSError as exc:
        log(f"device GUID read failed {event_path}: {exc}")
        return ""


def parse_es_input_cfg(path: str) -> list[dict]:
    if not os.path.isfile(path):
        return []
    try:
        tree = ET.parse(path)
    except (ET.ParseError, OSError) as exc:
        log(f"es_input parse failed {path}: {exc}")
        return []
    configs: list[dict] = []
    for ic in tree.getroot().findall("inputConfig"):
        if ic.get("type") != "joystick":
            continue
        inputs: dict[str, int] = {}
        input_types: dict[str, str] = {}
        for inp in ic.findall("input"):
            name = inp.get("name")
            code_s = inp.get("code")
            if not name or code_s is None:
                continue
            try:
                inputs[name] = int(code_s)
                input_types[name] = inp.get("type", "button")
            except ValueError:
                continue
        configs.append(
            {
                "deviceName": ic.get("deviceName", ""),
                "deviceGUID": ic.get("deviceGUID", ""),
                "inputs": inputs,
                "input_types": input_types,
            }
        )
    return configs


def load_es_input_configs() -> dict[str, dict]:
    """Merge Batocera system presets with userdata; later files override earlier."""
    by_guid: dict[str, dict] = {}
    for path in (ES_INPUT_SYSTEM, ES_INPUT_CFG, ES_LAST_INPUT_CFG):
        for cfg in parse_es_input_cfg(path):
            guid = (cfg.get("deviceGUID") or "").lower()
            if guid:
                by_guid[guid] = cfg
    return by_guid


def axis_triggered(
    axes: dict[int, int],
    caps: dict[int, tuple[int, int, int]],
    code: int,
    threshold: float = 0.75,
) -> bool:
    mn, mx, _flat = caps.get(code, (0, 255, 0))
    val = axes.get(code, mn)
    span = mx - mn
    if span <= 0:
        return val > 0
    return (val - mn) / span >= threshold


def select_active(bind: PadBindings, keys: dict[int, int]) -> bool:
    return any(key_down(keys, code) for code in bind.select_codes())


def select_modifier_active(bind: PadBindings, keys: dict[int, int]) -> bool:
    """SELECT or hotkey held (not Start; Start has its own combo)."""
    return select_active(bind, keys)


def start_active(bind: PadBindings, keys: dict[int, int]) -> bool:
    return bind.btn_start >= 0 and key_down(keys, bind.btn_start)


def r1_active(bind: PadBindings, keys: dict[int, int]) -> bool:
    return key_down(keys, bind.btn_r1)


def r2_active(
    bind: PadBindings,
    keys: dict[int, int],
    axes: dict[int, int],
    caps: dict[int, tuple[int, int, int]],
) -> bool:
    for code, is_axis in bind._r2_sources_list():
        if is_axis and axis_triggered(axes, caps, code):
            return True
        if not is_axis and key_down(keys, code):
            return True
    return False


def es_binding(inputs: dict[str, int], *names: str, default: int) -> int:
    """First matching ES slot name wins."""
    for name in names:
        if name in inputs:
            return inputs[name]
    return default


# Batocera EmulationStation legacy XML names vs wizard labels (InputConfig.cpp):
#   a=EAST, b=SOUTH, x=NORTH, y=WEST — not SDL a=south, b=east.
# Newer ES builds may write south/east/west/north directly; try those first.
ES_SLOT_LEGACY: dict[str, tuple[str, ...]] = {
    "south": ("south", "b"),
    "east": ("east", "a"),
    "west": ("west", "y"),
    "north": ("north", "x"),
}


def read_device_key_abs(event_path: str) -> tuple[frozenset[int], frozenset[int]]:
    """Return (key_codes, abs_axes) for this evdev node."""
    if not HAS_EVDEV:
        return frozenset(), frozenset()
    try:
        dev = InputDevice(event_path)
        caps = dev.capabilities()
        keys = frozenset(caps.get(EV_KEY, ()))
        abs_axes: set[int] = set(caps.get(EV_ABS, ()))
        # Capability bitmaps can omit axes that still respond to absinfo/events.
        for code in range(40):
            try:
                dev.absinfo(code)
            except (OSError, TypeError):
                continue
            abs_axes.add(code)
        dev.close()
    except OSError as exc:
        log(f"device caps read failed {event_path}: {exc}")
        return frozenset(), frozenset()
    return keys, frozenset(abs_axes)


def _pick_key(keys: frozenset[int], code: int, fallback: int) -> int:
    return code if code in keys else fallback


def find_r2_sources(
    event_path: str,
    keys: frozenset[int],
    abs_axes: frozenset[int],
) -> list[tuple[int, bool]]:
    """All plausible R2 inputs on this device (axis and/or button)."""
    sources: list[tuple[int, bool]] = []
    seen: set[tuple[int, bool]] = set()
    key_set = set(keys)
    abs_set = set(abs_axes)

    def add(code: int, is_axis: bool) -> None:
        item = (code, is_axis)
        if item not in seen:
            seen.add(item)
            sources.append(item)

    if 5 in abs_set:
        add(5, True)
    elif 2 in abs_set:
        add(2, True)
    else:
        extras = sorted(a for a in abs_set if a not in STICK_ABS)
        if extras and HAS_EVDEV:
            try:
                dev = InputDevice(event_path)
                trigger_axes: list[int] = []
                for axis in extras:
                    try:
                        ai = dev.absinfo(axis)
                    except (OSError, TypeError):
                        continue
                    span = ai.max - ai.min
                    if span <= 0:
                        continue
                    if span <= 255 or (ai.min >= 0 and ai.max <= 1023):
                        trigger_axes.append(axis)
                dev.close()
                if trigger_axes:
                    add(max(trigger_axes), True)
            except OSError as exc:
                log(f"trigger axis scan failed {event_path}: {exc}")

    if BTN_TR2 in key_set:
        add(BTN_TR2, False)
    if BTN_TR in key_set:
        pair_r2 = BTN_TR - 2
        if BTN_WEST < pair_r2 < BTN_TR:
            add(pair_r2, False)
        for code in sorted(c for c in key_set if BTN_WEST < c < BTN_TR):
            add(code, False)

    if not sources:
        add(BTN_TR2, False)
    return sources


def apply_r2_sources(bind: PadBindings, sources: list[tuple[int, bool]]) -> None:
    bind.r2_sources = sources
    if sources:
        bind.r2_code, bind.r2_is_axis = sources[0]


def find_r2_on_device(
    event_path: str,
    keys: frozenset[int],
    abs_axes: frozenset[int],
) -> tuple[int, bool]:
    sources = find_r2_sources(event_path, keys, abs_axes)
    return sources[0]


def bindings_from_evdev_device(event_path: str, device_guid: str) -> PadBindings:
    """Linux gamepad layout on this node when Batocera has no es_input profile."""
    keys, abs_axes = read_device_key_abs(event_path)
    guid_part = device_guid or "unknown GUID"
    b = PadBindings(
        source=f"evdev-scan (no ES profile for {guid_part})",
        es_guid=device_guid,
    )
    b.btn_left = _pick_key(keys, BTN_SOUTH, b.btn_left)
    b.btn_right = _pick_key(keys, BTN_EAST, b.btn_right)
    b.btn_combo_west = _pick_key(keys, BTN_WEST, b.btn_combo_west)
    b.btn_combo_north = _pick_key(keys, BTN_NORTH, b.btn_combo_north)
    b.btn_select = _pick_key(keys, BTN_SELECT, b.btn_select)
    b.btn_start = _pick_key(keys, BTN_START, b.btn_start)
    b.btn_r1 = _pick_key(keys, BTN_TR, b.btn_r1)
    apply_r2_sources(b, find_r2_sources(event_path, keys, abs_axes))
    return b


def bindings_from_es_inputs(
    inputs: dict[str, int],
    input_types: dict[str, str],
    device_name: str,
    device_guid: str,
) -> PadBindings:
    # Whatever physical button the user bound to each wizard slot is what we use.
    b = PadBindings(source="es_input", es_device=device_name, es_guid=device_guid)
    b.btn_left = es_binding(inputs, *ES_SLOT_LEGACY["south"], default=BTN_SOUTH)
    b.btn_right = es_binding(inputs, *ES_SLOT_LEGACY["east"], default=BTN_EAST)
    b.btn_combo_west = es_binding(inputs, *ES_SLOT_LEGACY["west"], default=BTN_WEST)
    b.btn_combo_north = es_binding(inputs, *ES_SLOT_LEGACY["north"], default=BTN_NORTH)
    if "select" in inputs:
        b.btn_select = inputs["select"]
    if "hotkey" in inputs:
        b.btn_hotkey = inputs["hotkey"]
    if "start" in inputs:
        b.btn_start = inputs["start"]
    if "pagedown" in inputs:
        b.btn_r1 = inputs["pagedown"]
    elif "pageup" in inputs:
        b.btn_r1 = inputs["pageup"]
    if "r2" in inputs:
        if input_types.get("r2") == "axis":
            b.r2_is_axis = True
            b.r2_code = inputs["r2"]
        else:
            b.r2_code = inputs["r2"]
        b.r2_sources = [(b.r2_code, b.r2_is_axis)]
    if "joystick1left" in inputs:
        b.abs_x = inputs["joystick1left"]
    if "joystick1up" in inputs:
        b.abs_y = inputs["joystick1up"]
    return b


def resolve_pad_bindings(
    event_path: str,
    es_configs_by_guid: dict[str, dict],
    use_es_input: bool,
) -> PadBindings:
    if not use_es_input:
        return PadBindings(source="disabled (use_es_input=0)")
    guid = evdev_device_guid(event_path)
    if guid:
        cfg = es_configs_by_guid.get(guid.lower())
        inputs = (cfg or {}).get("inputs") or {}
        if inputs:
            return bindings_from_es_inputs(
                inputs,
                cfg.get("input_types", {}),
                cfg.get("deviceName", ""),
                guid,
            )
    if not HAS_EVDEV:
        return PadBindings(source="unavailable (python3-evdev missing)")
    bindings = bindings_from_evdev_device(event_path, guid)
    log(
        f"{event_path}: {bindings.source}; "
        "map once in System Settings → ES Controller Mapping if probe is wrong"
    )
    return bindings


def alt_tab_allowed(
    session: SessionState,
    allow_mouse: bool,
    flycast_menu_cursor: bool,
) -> bool:
    if not session.fc_running:
        return False
    if session.in_lobby or session.crt_paused or flycast_menu_cursor:
        return True
    return allow_mouse


def alt_f4_allowed(session: SessionState) -> bool:
    """Quit emulator (Alt+F4) only while a game session is active, not in the lobby."""
    if not session.fc_running or session.in_lobby:
        return False
    return (
        session.fbneo_running
        or session.snes9x_running
        or session.flycast_game_active
    )


