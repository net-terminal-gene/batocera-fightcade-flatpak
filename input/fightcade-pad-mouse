def _fightcade_window_id(display: str) -> str:
    env = os.environ.copy()
    env["DISPLAY"] = display
    try:
        result = subprocess.run(
            ["xdotool", "search", "--name", "Fightcade"],
            env=env,
            capture_output=True,
