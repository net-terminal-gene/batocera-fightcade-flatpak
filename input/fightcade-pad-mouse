def drain_evdev(
    fd: int,
    axes: dict[int, int],
    keys: dict[int, int],
    tracked_abs: frozenset[int],
) -> bool:
    moved = False
    while True:
        try:
            data = os.read(fd, EVENT_STRUCT.size)
        except BlockingIOError:
            return moved
        if len(data) < EVENT_STRUCT.size:
            return moved
        _sec, _usec, ev_type, code, value = EVENT_STRUCT.unpack(data)
        if ev_type == EV_KEY:
            keys[code] = value
        elif ev_type == EV_ABS and code in tracked_abs:
            if axes.get(code, 0) != value:
                moved = True
            axes[code] = value
    return moved


def key_down(keys: dict[int, int], code: int) -> bool:
    return keys.get(code, 0) == 1


def pick_active_pad(
    pads: list[tuple[str, str]],
    activity: dict[str, float],
) -> str:
    if len(pads) == 1:
        return pads[0][1]
    if not activity:
        return pads[0][1]
    return max(activity, key=activity.get)


def run_loop(pads: list[tuple[str, str]], cfg: dict) -> None:
    display = pick_display()
    deadzone = int(cfg["deadzone"])
    deadzone_8bit = int(cfg.get("deadzone_8bit", DEFAULTS["deadzone_8bit"]))
    max_speed = float(cfg["max_speed"])
    slow_speed = float(cfg.get("slow_speed", DEFAULTS["slow_speed"]))
    poll_hz = max(20, int(cfg["poll_hz"]))
    poll_sec = 1.0 / poll_hz
    refresh_sec = float(cfg.get("session_refresh_sec", DEFAULTS["session_refresh_sec"]))
    lobby_refresh_sec = float(
        cfg.get("lobby_refresh_sec", DEFAULTS["lobby_refresh_sec"])
    )
    pointer_rescan_sec = float(
        cfg.get("pointer_rescan_sec", DEFAULTS["pointer_rescan_sec"])
    )
    combo_cooldown = max(1, int(cfg["crt_combo_cooldown_sec"]))
    use_es_input = bool(int(cfg.get("use_es_input", DEFAULTS["use_es_input"])))
    es_configs_by_guid = load_es_input_configs() if use_es_input else {}
    session = SessionState(
        refresh_sec=refresh_sec, lobby_refresh_sec=lobby_refresh_sec
    )
    xdotool = XdotoolClient(display)

    event_fds: dict[int, str] = {}
    axes_by_pad: dict[str, dict[int, int]] = {}
    axis_caps_by_pad: dict[str, dict[int, tuple[int, int, int]]] = {}
    keys_by_pad: dict[str, dict[int, int]] = {}
    bindings_by_pad: dict[str, PadBindings] = {}
    pad_activity: dict[str, float] = {}

    labels = ", ".join(p[0] for p in pads)
    log(f"gamepads: {labels} on DISPLAY={display} (SELECT+X pause, SELECT+Y resume)")
    disable_fake_touchpad_pointers(display)
    prime_x_pointer(display)
    set_cursor_visible(True, display)

    last_pointer_rescan = time.time()

    try:
        for label, event_path in pads:
            bindings = resolve_pad_bindings(event_path, es_configs_by_guid, use_es_input)
            bindings_by_pad[event_path] = bindings
            log_pad_bindings(label, bindings)
            keys_by_pad[event_path] = {}
            event_fds[os.open(event_path, os.O_RDONLY | os.O_NONBLOCK)] = event_path
            axis_caps_by_pad[event_path] = load_pad_axis_caps(event_path, bindings)
            axes_by_pad[event_path] = initial_axes(
                event_path, axis_caps_by_pad[event_path], bindings
            )
    except OSError as exc:
        log(f"open input device failed: {exc}")
        return

    left_held = False
    right_held = False
    pause_combo_was_active = False
    resume_combo_was_active = False
    last_pause_at = 0.0
    last_resume_at = 0.0
    last_tab_at = 0.0
    last_alt_f4_at = 0.0
    last_chat_at = {slot: 0.0 for slot in CHAT_SLOTS}
    chat_was_down = {slot: False for slot in CHAT_SLOTS}
    r1_was_down = False
    start_was_down = False
    cursor_visible = True
    flycast_menu_cursor = False
    select_was_down = False
    select_modifier_was_down = False
    all_fds = list(event_fds.keys())

    try:
        while True:
            session.refresh(display)
            if os.path.isfile(DISABLE) or not session.fc_running:
                if left_held:
                    set_mouse_button(False, xdotool, 1)
                    left_held = False
                if right_held:
                    set_mouse_button(False, xdotool, 3)
                    right_held = False
                if not cursor_visible:
                    set_cursor_visible(True, display)
                    cursor_visible = True
                flycast_menu_cursor = False
                time.sleep(0.5)
                continue

            if not session.flycast_game_active:
                flycast_menu_cursor = False

            if session.in_lobby:
                # Skip cursor hide/show and focus checks; lobby mouse is always on.
                allow_mouse = True
                allow_click = True
            else:
                allow_mouse = session.lobby_mouse_allowed(flycast_menu_cursor)
                allow_click = allow_mouse
                want_cursor = allow_mouse
                if want_cursor != cursor_visible:
                    set_cursor_visible(want_cursor, display)
                    cursor_visible = want_cursor

            _r, _, _ = select.select(all_fds, [], [], poll_sec)
            for fd in _r:
                event_path = event_fds[fd]
                axes = axes_by_pad[event_path]
                keys = keys_by_pad[event_path]
                bindings = bindings_by_pad[event_path]
                if drain_evdev(fd, axes, keys, bindings.tracked_abs):
                    pad_activity[event_path] = time.time()

            active_path = pick_active_pad(pads, pad_activity)
            key_state = keys_by_pad[active_path]
            bind = bindings_by_pad[active_path]

            select_down = select_active(bind, key_state)
            modifier_down = select_modifier_active(bind, key_state)
            r1_down = r1_active(bind, key_state)
            start_down = start_active(bind, key_state)
            left_down = key_down(key_state, bind.btn_left)
            right_down = key_down(key_state, bind.btn_right)
            chat_modifier_down = r1_down and not select_down
            if allow_click:
                if left_down and not select_down and not chat_modifier_down and not left_held:
                    set_mouse_button(True, xdotool, 1)
                    left_held = True
                elif (not left_down or select_down or chat_modifier_down) and left_held:
                    set_mouse_button(False, xdotool, 1)
                    left_held = False
                if right_down and not select_down and not chat_modifier_down and not right_held:
                    set_mouse_button(True, xdotool, 3)
                    right_held = True
                elif (not right_down or select_down or chat_modifier_down) and right_held:
                    set_mouse_button(False, xdotool, 3)
                    right_held = False
            else:
                if left_held:
                    set_mouse_button(False, xdotool, 1)
                    left_held = False
                if right_held:
                    set_mouse_button(False, xdotool, 3)
                    right_held = False

            now = time.time()
            if session.in_lobby and now - last_pointer_rescan >= pointer_rescan_sec:
                disable_fake_touchpad_pointers(display)
                last_pointer_rescan = now

            pause_active = select_down and key_down(key_state, bind.btn_combo_west)
            if (
                pause_active
                and not pause_combo_was_active
                and now - last_pause_at >= combo_cooldown
            ):
                if session.fbneo_combo_available():
                    trigger_crt_esc_pause()
                    last_pause_at = now
                    set_cursor_visible(True, display)
                    cursor_visible = True
                    log("SELECT+X triggered CRT pause (ESC)")
                elif session.flycast_combo_available():
                    flycast_menu_cursor = True
                    last_pause_at = now
                    set_cursor_visible(True, display)
                    cursor_visible = True
                    log("SELECT+X Flycast menu cursor on")
            pause_combo_was_active = pause_active

            resume_active = select_down and key_down(key_state, bind.btn_combo_north)
            if (
                resume_active
                and not resume_combo_was_active
                and now - last_resume_at >= combo_cooldown
            ):
                if session.fbneo_combo_available():
                    trigger_crt_resume()
                    last_resume_at = now
                    set_cursor_visible(False, display)
                    cursor_visible = False
                    log("SELECT+Y triggered CRT resume")
                elif session.flycast_combo_available():
                    flycast_menu_cursor = False
                    clear_crt_pause()
                    last_resume_at = now
                    set_cursor_visible(False, display)
                    cursor_visible = False
                    log("SELECT+Y Flycast menu cursor off")
            resume_combo_was_active = resume_active

            active_axes = axes_by_pad[active_path]
            active_caps = axis_caps_by_pad[active_path]
            r2_down = r2_active(bind, key_state, active_axes, active_caps)

            if (
                session.flycast_combo_available()
                and select_down
                and not select_was_down
                and not key_down(key_state, bind.btn_combo_west)
                and not key_down(key_state, bind.btn_combo_north)
                and not r1_down
                and not r2_down
                and not start_down
            ):
                flycast_menu_cursor = True
                set_cursor_visible(True, display)
                cursor_visible = True
            modifier_edge = modifier_down and not select_modifier_was_down
            select_modifier_was_down = modifier_down
            select_was_down = select_down
            r1_edge = r1_down and not r1_was_down

            allow_tab = alt_tab_allowed(session, allow_mouse, flycast_menu_cursor)
            if (
                allow_tab
                and modifier_down
                and r1_down
                and (r1_edge or modifier_edge)
                and now - last_tab_at >= combo_cooldown
            ):
                send_alt_tab(xdotool)
                last_tab_at = now
                log("SELECT+R1 sent Alt+Tab")

            if (
                alt_f4_allowed(session)
                and modifier_down
                and start_down
                and (not start_was_down or modifier_edge)
                and now - last_alt_f4_at >= combo_cooldown
            ):
                send_alt_f4(xdotool)
                last_alt_f4_at = now
                log("SELECT+Start sent Alt+F4")
            start_was_down = start_down

            if session.in_lobby and chat_modifier_down:
                chat_macros = load_chat_macros()
                chat_buttons = lobby_chat_button_state(
                    bind, key_state, active_axes, active_caps
                )
                for slot in CHAT_SLOTS:
                    message = chat_macros.get(slot)
                    down = chat_buttons[slot]
                    if not message:
                        chat_was_down[slot] = down
                        continue
                    if (
                        down
                        and (not chat_was_down[slot] or r1_edge)
                        and now - last_chat_at[slot] >= combo_cooldown
                    ):
                        send_lobby_chat_message(display, message)
                        last_chat_at[slot] = now
                        log(f"R1+{slot.upper()} sent chat: {message!r}")
                    chat_was_down[slot] = down
            else:
                for slot in CHAT_SLOTS:
                    chat_was_down[slot] = False
            r1_was_down = r1_down

            if allow_mouse:
                axes = active_axes
                caps = active_caps
                x_min, x_max, x_flat = caps.get(bind.abs_x, (-32768, 32767, 0))
                y_min, y_max, y_flat = caps.get(bind.abs_y, (-32768, 32767, 0))
                nx = axis_to_float(
                    axes.get(bind.abs_x, 0),
                    x_min,
                    x_max,
                    x_flat,
                    deadzone,
                    deadzone_8bit,
                )
                ny = axis_to_float(
                    axes.get(bind.abs_y, 0),
                    y_min,
                    y_max,
                    y_flat,
                    deadzone,
                    deadzone_8bit,
                )
                fine_nudge = r2_active(bind, key_state, axes, caps) and not chat_modifier_down
                move_speed = slow_speed if fine_nudge else max_speed
                dx = int(round(nx * move_speed))
                dy = int(round(ny * move_speed))
                hx = hat_to_step(axes.get(bind.abs_hat_x, 0))
                hy = hat_to_step(axes.get(bind.abs_hat_y, 0))
                step = int(round(move_speed))
                if hx:
                    dx += hx * step
                if hy:
                    dy += hy * step
                move_mouse(dx, dy, xdotool)
    finally:
        if left_held:
            set_mouse_button(False, xdotool, 1)
        if right_held:
            set_mouse_button(False, xdotool, 3)
        xdotool.close()
        for fd in all_fds:
            try:
                os.close(fd)
            except OSError:
                pass


def cmd_probe(device_match: str) -> int:
    print(
        "NOTE: probe is diagnostic only. It does NOT control Fightcade.\n"
        "Pad-mouse runs automatically when you launch Fightcade (daemon).\n"
        "In the Fightcade lobby: stick moves cursor, face buttons click, R2 slows.\n"
        "R1+SOUTH/EAST/WEST/NORTH/R2 send lobby chat (see fightcade-lobby-chat.conf).\n"
        "Below: press buttons — names should print (Ctrl+C to quit).\n",
        flush=True,
    )
    cfg = load_conf()
    use_es_input = bool(int(cfg.get("use_es_input", DEFAULTS["use_es_input"])))
    es_configs_by_guid = load_es_input_configs() if use_es_input else {}
    pads = list_gamepad_event_nodes(device_match)
    if not pads:
        print("no gamepads found")
        return 1
    macros = load_chat_macros()
    if macros:
        print("Lobby chat macros (R1 + slot):", flush=True)
        for slot in CHAT_SLOTS:
            if slot in macros:
                print(f"  {slot}: {macros[slot]!r}", flush=True)
        print(flush=True)
    for label, event_path in pads:
        guid = evdev_device_guid(event_path)
        bindings = resolve_pad_bindings(event_path, es_configs_by_guid, use_es_input)
        print(f"{label}: event={event_path}", flush=True)
        print(f"  deviceGUID={guid or '(unknown)'}", flush=True)
        print(
            f"  bindings={bindings.source}"
            + (f" ({bindings.es_device})" if bindings.es_device else ""),
            flush=True,
        )
        if bindings.source.startswith("evdev-scan"):
            print(
                "  NOTE: Batocera has no es_input preset for this GUID. "
                "Slots were scanned on this device only. "
                "If any button is wrong, map once in "
                "System Settings → ES Controller Mapping, then re-run probe.",
                flush=True,
            )
        for code, name in sorted(bindings.probe_button_names().items()):
            print(f"    {name}: evdev {code} ({code:#x})", flush=True)
        print(
            f"    stick axes: X={bindings.abs_x} Y={bindings.abs_y}"
            f" hat=({bindings.abs_hat_x},{bindings.abs_hat_y})",
            flush=True,
        )
        if bindings.r2_is_axis:
            print(f"    R2 slow-cursor axis: {bindings.r2_code}", flush=True)
        extra_r2 = bindings._r2_sources_list()
        if len(extra_r2) > 1:
            parts = [
                f"axis {c}" if ax else f"button {c} ({c:#x})"
                for c, ax in extra_r2
            ]
            print(f"    R2 sources (any active): {', '.join(parts)}", flush=True)
    print("Press buttons for 15s (Ctrl+C to stop early)...", flush=True)
    label, event_path = pads[0]
    bindings = resolve_pad_bindings(event_path, es_configs_by_guid, use_es_input)
    fd = os.open(event_path, os.O_RDONLY)
    end = time.time() + 15
    keys: dict[int, int] = {}
    axes: dict[int, int] = {}
    try:
        while time.time() < end:
            _r, _, _ = select.select([fd], [], [], 0.2)
            if _r:
                drain_evdev(fd, axes, keys, bindings.tracked_abs)
            moved = []
            for code in bindings.tracked_abs:
                if code in axes:
                    moved.append(f"{code}={axes[code]}")
            if moved:
                print("  " + " ".join(moved), flush=True)
            for code, val in sorted(keys.items()):
                if val:
                    name = bindings.probe_button_names().get(code, f"code_{code}")
                    print(f"  {name} ({code}) = {val}", flush=True)
    except KeyboardInterrupt:
        pass
    finally:
        os.close(fd)
    return 0


def daemon_start() -> int:
    if os.path.isfile(DISABLE):
        log("disabled via fightcade-pad-mouse.disable")
        return 0

    lock_fd = os.open(LOCKFILE, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    if os.path.isfile(PIDFILE):
        try:
            with open(PIDFILE, encoding="utf-8") as fh:
                old = int(fh.read().strip())
            os.kill(old, 0)
            return 0
        except (OSError, ValueError):
            pass

    cfg = load_conf()
    pairs = list_gamepad_event_nodes(str(cfg.get("device_match", "")))
    if not pairs:
        log("no gamepad found (check USB; optional device_match in fightcade-pad-mouse.conf)")
        return 0

    pid = os.fork()
    if pid > 0:
        return 0
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        os._exit(0)

    with open(PIDFILE, "w", encoding="utf-8") as fh:
        fh.write(str(os.getpid()))

    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGINT, lambda *_: sys.exit(0))

    try:
        run_loop(pairs, cfg)
    finally:
        try:
            os.remove(PIDFILE)
        except OSError:
            pass


def daemon_stop() -> None:
    if not os.path.isfile(PIDFILE):
        return
    try:
        with open(PIDFILE, encoding="utf-8") as fh:
            pid = int(fh.read().strip())
        os.kill(pid, signal.SIGTERM)
        for _ in range(20):
            try:
                os.kill(pid, 0)
            except OSError:
                break
            time.sleep(0.1)
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    except (OSError, ValueError):
        pass
    for path in (PIDFILE, LOCKFILE):
        try:
            os.remove(path)
        except OSError:
            pass


def cmd_status() -> None:
    if os.path.isfile(DISABLE):
        print("disabled")
    if os.path.isfile(PIDFILE):
        with open(PIDFILE, encoding="utf-8") as fh:
            print(f"running pid {fh.read().strip()}")
    else:
        print("not running")
    if os.path.isfile(FBNEO_FLAG):
        print("wine emu crt session: active (fbneo/snes9x)")
    if os.path.isfile(FLYCAST_GAME_FLAG):
        print("flycast game session: active")
    cfg = load_conf()
    pairs = list_gamepad_event_nodes(str(cfg.get("device_match", "")))
    if pairs:
        for label, event_path in pairs:
            print(f"  {label}: event={event_path}")
    else:
        print("gamepads: none")


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "daemon":
        return daemon_start()
    if cmd == "stop":
        daemon_stop()
        return 0
    if cmd == "status":
        cmd_status()
        return 0
    if cmd == "probe":
        cfg = load_conf()
        return cmd_probe(str(cfg.get("device_match", "")))
    sys.stderr.write("Usage: fightcade-pad-mouse daemon|stop|status|probe\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
