#!/usr/bin/env python3
# Map gamepad stick/d-pad to X mouse cursor for Fightcade lobby UI.
# SELECT+WEST/NORTH: FBNeo/SNES menu pause/resume (CRT + HD); Flycast menu cursor.
# SELECT+Start: Alt+F4 quit emulator back to lobby.
# R1+SOUTH/EAST/WEST/NORTH/R2 (lobby): send chat macros from fightcade-lobby-chat.conf.
# Pad keyboard leaks (Alt+Enter etc.) are blocked by fightcade-crt-block-pad-kbd.
#
# Usage:
#   fightcade-pad-mouse daemon
#   fightcade-pad-mouse stop|status|probe

