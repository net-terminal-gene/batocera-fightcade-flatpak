def load_pad_axis_caps(
    event_path: str,
    bindings: PadBindings | None = None,
) -> dict[int, tuple[int, int, int]]:
    """Return ABS code -> (min, max, flat) from the device."""
    b = bindings or PadBindings()
    defaults = {
        b.abs_x: (-32768, 32767, 0),
        b.abs_y: (-32768, 32767, 0),
        b.abs_hat_x: (-1, 1, 0),
        b.abs_hat_y: (-1, 1, 0),
    }
    if b.r2_is_axis:
        defaults[b.r2_code] = (0, 255, 0)
    for code, is_axis in b._r2_sources_list():
        if is_axis:
            defaults.setdefault(code, (0, 255, 0))
    if not HAS_EVDEV:
        return defaults
    caps: dict[int, tuple[int, int, int]] = {}
    try:
        dev = InputDevice(event_path)
        for code in b.tracked_abs:
            try:
                ai = dev.absinfo(code)
            except (OSError, TypeError):
                continue
            caps[code] = (ai.min, ai.max, ai.flat)
        dev.close()
    except OSError as exc:
        log(f"axis caps read failed {event_path}: {exc}")
    for code, fallback in defaults.items():
        caps.setdefault(code, fallback)
    return caps


def initial_axes(
    event_path: str,
    caps: dict[int, tuple[int, int, int]],
    bindings: PadBindings | None = None,
) -> dict[int, int]:
    """Seed stick state from the kernel; evdev does not emit ABS on open."""
    b = bindings or PadBindings()
    axes: dict[int, int] = {}
    if HAS_EVDEV:
        try:
            dev = InputDevice(event_path)
            for code in b.tracked_abs:
                try:
                    axes[code] = dev.absinfo(code).value
                except (OSError, TypeError):
                    mn, mx, _flat = caps.get(code, (0, 0, 0))
                    axes[code] = int((mn + mx) / 2) if code in (b.abs_x, b.abs_y) else 0
            dev.close()
            return axes
        except OSError as exc:
            log(f"initial axes read failed {event_path}: {exc}")
    for code in (b.abs_x, b.abs_y):
        mn, mx, _flat = caps.get(code, (-32768, 32767, 0))
        axes[code] = int((mn + mx) / 2)
    axes[b.abs_hat_x] = 0
    axes[b.abs_hat_y] = 0
    return axes


def disable_fake_touchpad_pointers(display: str) -> None:
    """Disable gamepad-emulated X pointers (DualSense touchpad, Brook stick-as-mouse, etc.)."""
    try:
        out = subprocess.run(
            ["xinput", "list"],
            env={**os.environ, "DISPLAY": display},
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
        if out.returncode != 0:
            return
        env = {**os.environ, "DISPLAY": display}
        for line in out.stdout.splitlines():
            if not _xinput_slave_pointer_line(line):
                continue
            if not _xinput_phantom_pointer_name(line):
                continue
            match = re.search(r"\bid=(\d+)\b", line)
            if not match:
                continue
            dev_id = match.group(1)
            subprocess.run(
                ["xinput", "disable", dev_id],
                env=env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=2,
                check=False,
            )
            log(f"disabled X phantom pointer id={dev_id} ({line.strip()})")
    except (OSError, subprocess.SubprocessError):
        pass


def _xinput_slave_pointer_line(line: str) -> bool:
    lower = line.lower()
    return "slave" in lower and "pointer" in lower


def _xinput_phantom_pointer_name(line: str) -> bool:
    """True for gamepad/touchpad pointers; false for core XTEST and real mice."""
    lower = line.lower()
    if "xtest" in lower or "virtual core" in lower:
        return False
    if "mouse" in lower and "controller" not in lower and "gamepad" not in lower:
        return False
    markers = (
        "touchpad",
        "brook",
        "dualsense",
        "dualshock",
        "wireless controller",
        "gamepad",
        "x-box",
        "xbox",
        "8bitdo",
        "retro",
        "fightstick",
        "arcade stick",
    )
    return any(marker in lower for marker in markers)


def prime_x_pointer(display: str) -> None:
    """Sync xdotool with the live cursor (Brook drift clears after real mouse nudge)."""
    env = {**os.environ, "DISPLAY": display}
    try:
        out = subprocess.run(
            ["xdotool", "getmouselocation", "--shell"],
            env=env,
            capture_output=True,
            text=True,
            timeout=2,
            check=False,
        )
        if out.returncode != 0:
            return
        coords: dict[str, str] = {}
        for line in out.stdout.splitlines():
            if "=" in line:
                key, val = line.split("=", 1)
                coords[key.strip()] = val.strip()
        x, y = coords.get("X"), coords.get("Y")
        if x is None or y is None:
            return
        subprocess.run(
            ["xdotool", "mousemove", "--sync", x, y],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )
    except (OSError, subprocess.SubprocessError):
        pass


def axis_to_float(
    value: int,
    min_v: int,
    max_v: int,
    flat: int,
    deadzone_16bit: int,
    deadzone_8bit: int,
) -> float:
    center = (min_v + max_v) / 2.0
    half_span = max(max_v - center, center - min_v)
    if half_span <= 0:
        return 0.0
    if max_v <= 255:
        dz = float(deadzone_8bit if deadzone_8bit > 0 else max(flat, 15))
    else:
        dz = float(deadzone_16bit)
    delta = value - center
    if abs(delta) <= dz:
        return 0.0
    usable = half_span - dz
    if usable <= 0:
        return 0.0
    sign = 1 if delta > 0 else -1
    mag = (abs(delta) - dz) / usable
    return sign * min(1.0, mag)


def apply_deadzone(value: int, deadzone: int) -> float:
    if abs(value) <= deadzone:
        return 0.0
    span = 32767 - deadzone
    if span <= 0:
        return 0.0
    sign = 1 if value > 0 else -1
    mag = (abs(value) - deadzone) / span
    return sign * min(1.0, mag)


def hat_to_step(value: int) -> int:
    if value == 0:
        return 0
    return 1 if value > 0 else -1


