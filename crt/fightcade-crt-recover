#!/bin/bash
# Emergency CRT recovery for Flatpak Fightcade (stuck Switchres / orphaned emulators).
# Called from the gameStop hook or manually after a bad session.

PROJECT_DIR="/userdata/system/fightcade-flatpak"
CRT_DIR="${PROJECT_DIR}/crt"
WRAP="${CRT_DIR}/fightcade-crt-switchres"

# Stop any legacy log-tail daemon from older installs.
LEGACY="${PROJECT_DIR}/fightcade-crt-watch"
HOSTD="${CRT_DIR}/fightcade-crt-hostd"
if [ -x "$HOSTD" ]; then
    "$HOSTD" stop 2>/dev/null || true
fi
if [ -x "$LEGACY" ]; then
    "$LEGACY" stop 2>/dev/null || true
fi
rm -f /tmp/fightcade-crt-watch.pid /tmp/fightcade-crt-watch.lock \
      /tmp/fightcade-crt-watch.state /tmp/fightcade-crt-watch.pause

if [ -x "$WRAP" ]; then
    exec "$WRAP" recover
fi

export DISPLAY=:0.0
[ -S /tmp/.X11-unix/X0 ] || export DISPLAY=:0.0
batocera-resolution minTomaxResolution 2>/dev/null || true
