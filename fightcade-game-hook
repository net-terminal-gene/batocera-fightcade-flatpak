#!/bin/bash
# Batocera gameStart/gameStop hook for Flatpak Fightcade.
#
# gameStart: ROM sync, pad-to-mouse for Fightcade UI, CRT host watcher (CRT only).
# gameStop:  stop pad-mouse + CRT host watcher and run CRT recovery.
# Patched xdg-open writes play.pending; fightcade-crt-hostd runs dispatch on the host.

EVENT="$1"
SYSTEM="${2:-}"
ROM="${5:-}"

APP_ID="com.fightcade.Fightcade"
PROJECT_DIR="/userdata/system/fightcade-flatpak"
SYNC_SCRIPT="${PROJECT_DIR}/fightcade-roms-sync"
CRT_HOSTD="${PROJECT_DIR}/crt/fightcade-crt-hostd"
CRT_RECOVER="${PROJECT_DIR}/crt/fightcade-crt-recover"
PAD_MOUSE="${PROJECT_DIR}/input/fightcade-pad-mouse"
LOBBY_ZOOM="${PROJECT_DIR}/fightcade-lobby-zoom"
COLLECT_LOGS="${PROJECT_DIR}/fightcade-collect-logs"
LOG_DIR="/userdata/system/logs"

# Runtime flag the switchres wrapper and pad-mouse check for verbose logging.
# Set from the per-game "FIGHTCADE DEBUG LOGGING" toggle (Advanced Game Options),
# which writes flatpak["Fightcade.flatpak"].fcdebug = 1 (ON) or empty (OFF).
FC_DEBUG_FLAG="/tmp/fightcade-debug.on"

# Lobby chat macros edited per game in Advanced Game Options ("EDIT LOBBY CHAT").
# Each slot is stored as flatpak["Fightcade.flatpak"].fclobby_<slot> and synced into
# the pad-mouse chat config at gameStart (see sync_lobby_chat).
LOBBY_CHAT_CONF="/userdata/system/configs/fightcade-lobby-chat.conf"
LOBBY_CHAT_SHIPPED="${PROJECT_DIR}/input/fightcade-lobby-chat.conf"
BATOCERA_CONF="/userdata/system/batocera.conf"

fightcade_debug_enabled() {
    local v
    v=$(batocera-settings-get 'flatpak["Fightcade.flatpak"].fcdebug' 2>/dev/null | tr -d '[:space:]')
    [ "$v" = "1" ]
}

# Write one lobby-chat slot into LOBBY_CHAT_CONF from its batocera.conf key.
# A key that is PRESENT (even empty) is authoritative: its value replaces that
# slot line, and an empty value disables the slot. A key that is ABSENT is left
# untouched, so a manually edited .conf survives. Values may contain spaces and
# punctuation, so the raw text after the first '=' is used verbatim and passed to
# awk via the environment to avoid any quoting/escaping pitfalls.
sync_lobby_chat_slot() {
    local slot="$1" key line val
    key="flatpak[\"Fightcade.flatpak\"].fclobby_${slot}"
    line=$(grep -F -- "${key}=" "$BATOCERA_CONF" 2>/dev/null | tail -1)
    [ -n "$line" ] || return 0
    val="${line#*=}"
    if [ ! -f "$LOBBY_CHAT_CONF" ] && [ -f "$LOBBY_CHAT_SHIPPED" ]; then
        cp -f "$LOBBY_CHAT_SHIPPED" "$LOBBY_CHAT_CONF" 2>/dev/null || true
    fi
    [ -f "$LOBBY_CHAT_CONF" ] || return 0
    SLOT="$slot" NEWVAL="$val" awk '
        BEGIN { s = ENVIRON["SLOT"]; done = 0 }
        $0 ~ ("^" s "=") { print s "=" ENVIRON["NEWVAL"]; done = 1; next }
        { print }
        END { if (!done) print s "=" ENVIRON["NEWVAL"] }
    ' "$LOBBY_CHAT_CONF" > "${LOBBY_CHAT_CONF}.tmp" 2>/dev/null \
        && mv "${LOBBY_CHAT_CONF}.tmp" "$LOBBY_CHAT_CONF"
}

sync_lobby_chat() {
    local slot
    for slot in south east west north r2; do
        sync_lobby_chat_slot "$slot"
    done
}

[ "$SYSTEM" = "flatpak" ] || exit 0

case "$EVENT" in
    gameStart|gameStop) ;;
    *) exit 0 ;;
esac

if [ -f "$ROM" ]; then
    rom_id=$(cat "$ROM" 2>/dev/null | tr -d '[:space:]')
    [ "$rom_id" = "$APP_ID" ] || exit 0
else
    exit 0
fi

if [ "$EVENT" = "gameStop" ]; then
    # When debug logging was on this session, auto-write ONE plain-text report to
    # /userdata/system/logs/fightcade-debug-*.txt so a non-terminal user can grab it
    # straight off the Samba share (\\HOST\share\system\logs) and drag it into a
    # GitHub issue or Discord. Kicked off before teardown, backgrounded, so returning
    # to the lobby is not delayed. The transient /tmp/pad-mouse.log still exists here
    # and gets folded into the report.
    if [ -f "$FC_DEBUG_FLAG" ]; then
        mkdir -p "$LOG_DIR"
        if [ -x "$COLLECT_LOGS" ]; then
            setsid "$COLLECT_LOGS" --auto >/tmp/fightcade-collect.log 2>&1 </dev/null &
        else
            [ -f /tmp/pad-mouse.log ] && cp -f /tmp/pad-mouse.log "$LOG_DIR/fightcade-pad-mouse.log" 2>/dev/null || true
        fi
    fi
    [ -x "$LOBBY_ZOOM" ] && "$LOBBY_ZOOM" save >>/tmp/fightcade-lobby-zoom.log 2>&1 || true
    [ -x "$PAD_MOUSE" ] && "$PAD_MOUSE" stop
    [ -x "$CRT_HOSTD" ] && "$CRT_HOSTD" stop
    [ -x "$CRT_RECOVER" ] && "$CRT_RECOVER"
    rm -f "$FC_DEBUG_FLAG"
    exit 0
fi

# --- gameStart ---

# Set the debug flag before pad-mouse and the CRT host watcher start, so both pick
# up verbose logging for this session. Cleared here when the toggle is off.
if fightcade_debug_enabled; then
    : > "$FC_DEBUG_FLAG"
else
    rm -f "$FC_DEBUG_FLAG"
fi

# Push any per-game lobby-chat edits into the conf before pad-mouse starts below.
sync_lobby_chat

# Runs before Fightcade launches, so Chromium reads the mode-correct lobby zoom
# from Preferences at startup. Must stay synchronous (not backgrounded).
if [ -x "$LOBBY_ZOOM" ]; then
    "$LOBBY_ZOOM" apply >>/tmp/fightcade-lobby-zoom.log 2>&1 || true
fi

if [ -x "$SYNC_SCRIPT" ]; then
    "$SYNC_SCRIPT" --quiet
fi

if [ -x "$PAD_MOUSE" ] && [ ! -f /userdata/system/configs/fightcade-pad-mouse.disable ]; then
    "$PAD_MOUSE" stop >/dev/null 2>&1 || true
    sleep 0.1
    setsid "$PAD_MOUSE" daemon >>/tmp/pad-mouse.log 2>&1 </dev/null &
fi

if [ -x "$CRT_HOSTD" ]; then
    FC_DISPLAY=":0.0"
    [ -S /tmp/.X11-unix/X0 ] || FC_DISPLAY=":0.0"
    setsid env DISPLAY="$FC_DISPLAY" "$CRT_HOSTD" ensure >/dev/null 2>&1 </dev/null &
fi
