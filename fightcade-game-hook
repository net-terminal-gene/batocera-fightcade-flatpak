#!/bin/bash
# Batocera gameStart/gameStop hook for Flatpak Fightcade.
#
# Installed to /userdata/system/scripts/fightcade-game-hook by install.sh.
# Batocera's emulatorlauncher calls every executable in that directory with:
#
#   <script> <event> <system> <emulator> <core> <rom>
#
# gameStart: fires fightcade-roms-sync so any ROMs added to
# /userdata/roms/fbneo since the last launch are linked automatically, then
# starts the Switchres CRT watcher (a no-op on non-CRT / HD setups).
# gameStop: stops the CRT watcher and restores configs/display if needed.
# All other events and systems are silently ignored.

EVENT="$1"
SYSTEM="${2:-}"
ROM="${5:-}"

APP_ID="com.fightcade.Fightcade"
PROJECT_DIR="/userdata/system/fightcade-flatpak"
SYNC_SCRIPT="${PROJECT_DIR}/fightcade-roms-sync"
CRT_WATCH="${PROJECT_DIR}/fightcade-crt-watch"

[ "$SYSTEM" = "flatpak" ] || exit 0

case "$EVENT" in
    gameStart|gameStop) ;;
    *) exit 0 ;;
esac

# Match by rom file contents: the .flatpak file contains the app ID.
if [ -f "$ROM" ]; then
    rom_id=$(cat "$ROM" 2>/dev/null | tr -d '[:space:]')
    [ "$rom_id" = "$APP_ID" ] || exit 0
else
    exit 0
fi

if [ "$EVENT" = "gameStop" ]; then
    [ -x "$CRT_WATCH" ] && "$CRT_WATCH" stop
    exit 0
fi

# --- gameStart ---

if [ -x "$SYNC_SCRIPT" ]; then
    "$SYNC_SCRIPT" --quiet
else
    printf '[WARN] fightcade-game-hook: sync script not found at %s\n' "$SYNC_SCRIPT" >&2
fi

# Start the CRT watcher in the background; it exits immediately unless the
# display is an xorg CRT setup (or the force file is present).
if [ -x "$CRT_WATCH" ]; then
    # Stop any prior watcher (orphan daemons from repeated gameStart) before starting one.
    "$CRT_WATCH" stop >/dev/null 2>&1 || true
    sleep 0.15
    # setsid detaches the daemon from the launcher's process group so it
    # survives the hook returning and is only stopped by the gameStop event.
    setsid "$CRT_WATCH" daemon >/dev/null 2>&1 </dev/null &
fi
